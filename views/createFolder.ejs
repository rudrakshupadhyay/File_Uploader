<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>New Folder</title>
    <link rel="stylesheet" href="   /signupStyle.css" />
  </head>
  <body>
    <div class="container">
      <div class="top">
        <h1>New Folder</h1>
      </div>
      <div class="page">
        <form action="<%= isEditing ? `/renamefolder/${folder.id}` : '/createfolder' %>" method="POST" class="mainform">
          <div>
            <label for="name">Name</label>
            <input
              type="text"
              name="name"
              placeholder="Enter the name"
              id="name"
              required
              <% if (typeof folder !== 'undefined') { %> value="<%= folder.name %>" <% } %>
            />
          </div>
          <button type="submit">Create Folder</button>
        </form>
      </div>
    </div>
  </body>
</html>
