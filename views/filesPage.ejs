<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="/filePageStyle.css">
    <title>Files</title>
  </head>
  <body>
    <div class="fileContainer">
        <%- include("./portion/header") %>
        <% if(fileListSize == 0){ %>
            <div class="fileworkspace">
                <% if(errors){ %>
                    <div class="errorMessage"><%= errors %></div>
                <% } %>
                <div class="noFolder">
                    <div class="noFolderMessage">
                        <div>Your folder is empty</div>
                        <div>Upload your first file to start organizing your documents.</div>
                    </div>
                    <form action="/folder/<%= folderId %>/upload" method="post" enctype="multipart/form-data" class="upload-form">
                        <div class="file-upload-container">
                            <label for="file-upload" class="SelectFileLabel" id="fileLabel">Select File</label>
                            <input id="file-upload" type="file" hidden  name="file"/>
                            <div id="selectedFile"></div>
                        </div>
                        <button type="submit" class="upload-btn">Upload</button>
                    </form>
                </div>
            </div>
        <% } else { %>
            <div class="fileList">
                <% if(errors){ %>
                    <div class="errorMessage"><%= errors %></div>
                <% } %>
                <form action="/folder/<%= folderId %>/upload" method="post" enctype="multipart/form-data" class="upload-form">
                    <div class="file-upload-container">
                        <label for="file-upload" class="SelectFileLabel" id="fileLabel">Select File</label>
                        <input id="file-upload" type="file" hidden  name="file"/>
                        <div id="selectedFile"></div>
                    </div>
                    <button type="submit" class="upload-btn">Upload</button>
                </form>
                <ul class="listOfFiles">
                    <% fileList.forEach((file) => { %>
                        <li class="file">
                            <div class="fileName"><%= file.original_name %></div>
                            <div class="fileDetails">
                                <div>Size: <%= (file.size / 1024).toFixed(2) %> KB |</div>
                                <div>Type: <%= file.file_type %> |</div>
                                <div>Uploaded At: <%= file.createdAt.toLocaleString() %> |</div>
                                <a href="/folder/<%= folderId %>/view/<%= file.id %>" class="viewFileBtn">View</a>
                                <a href="/folder/<%= folderId %>/download/<%= file.id %>" class="downloadFileBtn">Download</a>
                                <form action="/folder/<%= folderId %>/delete/<%= file.id %>?_method=DELETE" method="POST" class="deleteFileForm">
                                    <button type="submit" class="deleteFileBtn">Delete</button>
                                </form>
                            </div>
                        </li>
                    <% }) %>
                </ul>          
            </div>
        <% } %>
    </div>
    <script>
        const fileInput = document.getElementById("file-upload");
        const fileLabel = document.getElementById("fileLabel");
        const selectedFile = document.getElementById("selectedFile");

        fileInput.addEventListener("change", () => {
            if (fileInput.files.length > 0) {
                fileLabel.textContent = "Change File";
                selectedFile.textContent = fileInput.files[0].name;
            } else {
                fileLabel.textContent = "Select File";
                selectedFile.textContent = "";
            }
        });
    </script>
  </body>
</html>
