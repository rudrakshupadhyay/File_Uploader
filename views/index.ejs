<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="homePageStyle.css">
    <title>Home Page</title>
  </head>
  <body>
    <div class="homeContainer">
        <%- include("./portion/header") %>
        <% if(folderListSize == 0){ %>
            <div class="workspace">
                <div class="noFolder">
                    <div class="noFolderMessage">
                        <div>Your drive is empty</div>
                        <div>Create your first folder to start organizing your files.</div>
                    </div>
                    <a href="/createfolder" class="create-folder-btn">Create Folder</a>
                </div>
            </div>
        <% } else { %>
            <div class="folderList">
                <div>
                    <a href="/createfolder" class="create-folder-btn">Create Folder</a>
                </div>
                <ul class="listOfFolder">
                    <% folderList.forEach((folder) => { %>
                        <li class="folder">
                            <div class="folderName"><%= folder.name %></div>
                            <div class="folderDetails">
                                <div>Number of files: <%= folder.files.length %> |</div>
                                <div>Created At: <%= folder.createdAt.toLocaleString() %> |</div>
                                <a href="/folder/<%= folder.id %>" class="openfolder">Open folder</a>
                                <a href="/renamefolder/<%= folder.id %>" class="renameFolderBtn">Rename</a>
                                <form action="/deletefolder/<%= folder.id %>?_method=DELETE" method="POST" class="deleteFolderForm">
                                    <button type="submit" class="deleteFolderBtn">Delete</button>
                                </form>
                            </div>
                        </li>
                    <% }) %>
                </ul>
            </div>
        <% } %>

    </div>
  </body>
</html>
